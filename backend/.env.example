# ============================================
# EduComfort — Environment Variables Template
# Copy to .env and fill in your values
# ============================================

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/educomfort

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_generate_with_secrets_module
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# --- CORS (comma-separated list of allowed origins) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AWS S3 (for file/media storage) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=educomfort-media
AWS_S3_REGION=us-east-1

# --- Environment ---
# MUST be "production" on the server (hides /docs and error tracebacks)
ENVIRONMENT=development

# --- Error Monitoring ---
SENTRY_DSN=

# --- Email (use SendGrid or Resend) ---
EMAIL_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# --- SMS — Eskiz (O'zbekiston) ---
# https://eskiz.uz saytida ro'yxatdan o'ting
ESKIZ_EMAIL=siz@email.com
ESKIZ_PASSWORD=eskiz_parolingiz

# --- Platform owner (created on first start if missing) ---
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PASSWORD=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Same value you pass to setWebhook(secret_token=...)
TELEGRAM_WEBHOOK_SECRET=
