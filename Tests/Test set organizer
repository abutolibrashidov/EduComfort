"""
Test Set Organizer - Organize tests into Set 1 and Set 2 folders
For anti-cheating parallel test system
"""

import json
import os
import shutil
import re
from pathlib import Path
from typing import Dict, List, Optional, Tuple

class TestSetOrganizer:
    """Organize tests into Set 1 and Set 2 structure."""
    
    def __init__(self, base_dir: str = "tests"):
        self.base_dir = Path(base_dir)
        self.organized_count = 0
        
    def detect_level(self, filename: str, folder_path: str) -> str:
        """Detect test level from filename or folder."""
        filename_lower = filename.lower()
        folder_lower = folder_path.lower()
        
        if 'elementary' in folder_lower or 'elem' in folder_lower:
            return 'elementary'
        elif 'pre-intermediate' in folder_lower or 'pre int' in folder_lower:
            return 'pre-intermediate'
        elif 'intermediate' in folder_lower and 'pre' not in folder_lower:
            return 'intermediate'
        
        return 'elementary'  # default
    
    def detect_unit(self, filename: str) -> Optional[str]:
        """Extract unit number from filename."""
        filename_lower = filename.lower()
        
        # Check for cumulative tests
        if 'cumulative' in filename_lower or 'test_1-' in filename_lower:
            return 'cumulative'
        
        # Extract unit number
        unit_match = re.search(r'unit\s*(\d+)', filename_lower)
        if unit_match:
            return f"unit{unit_match.group(1)}"
        
        return None
    
    def detect_test_set_and_type(self, filename: str) -> Tuple[int, str]:
        """
        Detect which test set (1 or 2) and type (progress/short).
        
        Returns: (set_number, test_type)
        
        Examples:
        - "Unit 9 Progress Test A.json" → (1, "progress")
        - "Unit 9 Progress Test B.json" → (2, "progress")
        - "Unit 9 Short Test 1A.json" → (1, "short_pre")
        - "Unit 9 Short Test 1B.json" → (1, "short_post")
        - "Unit 9 Short Test 2A.json" → (2, "short_pre")
        - "Unit 9 Short Test 2B.json" → (2, "short_post")
        """
        filename_lower = filename.lower()
        
        # Determine test set
        if 'progress' in filename_lower and ' a' in filename_lower:
            return (1, "progress")
        elif 'progress' in filename_lower and ' b' in filename_lower:
            return (2, "progress")
        elif 'short' in filename_lower and '1a' in filename_lower.replace(' ', ''):
            return (1, "short_pre")
        elif 'short' in filename_lower and '1b' in filename_lower.replace(' ', ''):
            return (1, "short_post")
        elif 'short' in filename_lower and '2a' in filename_lower.replace(' ', ''):
            return (2, "short_pre")
        elif 'short' in filename_lower and '2b' in filename_lower.replace(' ', ''):
            return (2, "short_post")
        
        # Fallback
        return (1, "unknown")
    
    def standardize_filename(self, test_type: str) -> str:
        """Create standardized filename based on test type."""
        filenames = {
            "progress": "progress_test.json",
            "short_pre": "short_test_pre.json",
            "short_post": "short_test_post.json"
        }
        return filenames.get(test_type, "test.json")
    
    def create_directory_structure(self):
        """Create base directory structure."""
        print("📁 Creating directory structure...")
        
        levels = ["elementary", "pre-intermediate", "intermediate"]
        
        for level in levels:
            level_path = self.base_dir / level
            level_path.mkdir(parents=True, exist_ok=True)
        
        # Create results directory
        Path("results").mkdir(exist_ok=True)
        
        print("✅ Directory structure created")
    
    def organize_test_file(self, source_file: Path, source_root: Path) -> bool:
        """Organize a single test file into set1 or set2."""
        try:
            # Get relative path
            rel_path = source_file.relative_to(source_root)
            
            # Detect properties
            level = self.detect_level(source_file.name, str(rel_path.parent))
            unit = self.detect_unit(source_file.name)
            
            if not unit:
                print(f"⚠️  Skipping {source_file.name} - couldn't detect unit")
                return False
            
            if unit == 'cumulative':
                # Cumulative tests don't use set structure
                target_dir = self.base_dir / level / "cumulative"
                target_dir.mkdir(parents=True, exist_ok=True)
                target_file = target_dir / source_file.name
                shutil.copy2(source_file, target_file)
                print(f"✅ {source_file.name} → {level}/cumulative/")
                return True
            
            # Detect test set and type
            set_number, test_type = self.detect_test_set_and_type(source_file.name)
            
            # Create target directory
            target_dir = self.base_dir / level / unit / f"set{set_number}"
            target_dir.mkdir(parents=True, exist_ok=True)
            
            # Standardize filename
            new_filename = self.standardize_filename(test_type)
            target_file = target_dir / new_filename
            
            # Copy file
            shutil.copy2(source_file, target_file)
            
            print(f"✅ {source_file.name}")
            print(f"   → {level}/{unit}/set{set_number}/{new_filename}")
            
            self.organized_count += 1
            return True
            
        except Exception as e:
            print(f"❌ Error organizing {source_file.name}: {e}")
            return False
    
    def scan_and_organize(self, source_dir: str):
        """Scan source directory and organize all tests."""
        source_path = Path(source_dir)
        
        if not source_path.exists():
            print(f"❌ Source directory not found: {source_dir}")
            return
        
        print(f"\n📂 Scanning: {source_dir}")
        print("="*70)
        
        # Find all JSON files
        json_files = list(source_path.rglob("*.json"))
        
        # Filter out VS Code and system files
        json_files = [f for f in json_files if '.vs' not in str(f) and not f.name.startswith('.')]
        
        print(f"Found {len(json_files)} test files\n")
        
        for json_file in json_files:
            self.organize_test_file(json_file, source_path)
        
        print(f"\n{'='*70}")
        print(f"✅ Organized {self.organized_count} tests")
    
    def generate_metadata(self):
        """Generate metadata.json for each unit."""
        print("\n📝 Generating metadata files...")
        
        levels = ["elementary", "pre-intermediate", "intermediate"]
        
        for level in levels:
            level_path = self.base_dir / level
            
            if not level_path.exists():
                continue
            
            # Process each unit
            for unit_dir in sorted(level_path.iterdir()):
                if not unit_dir.is_dir() or unit_dir.name == 'cumulative':
                    continue
                
                metadata = self.create_unit_metadata(unit_dir)
                
                if metadata:
                    metadata_file = unit_dir / "metadata.json"
                    with open(metadata_file, 'w', encoding='utf-8') as f:
                        json.dump(metadata, f, indent=2, ensure_ascii=False)
                    
                    print(f"✅ Created metadata for {level}/{unit_dir.name}")
    
    def create_unit_metadata(self, unit_dir: Path) -> Optional[Dict]:
        """Create metadata for a single unit."""
        metadata = {
            "level": unit_dir.parent.name,
            "unit": unit_dir.name,
            "title": f"{unit_dir.name.replace('unit', 'Unit ')} Tests",
            "test_sets": []
        }
        
        # Check for set1 and set2
        for set_num in [1, 2]:
            set_dir = unit_dir / f"set{set_num}"
            
            if not set_dir.exists():
                continue
            
            set_info = {
                "set_number": set_num,
                "tests": {},
                "status": "incomplete",
                "missing": []
            }
            
            # Expected files
            expected_files = {
                "short_pre": "short_test_pre.json",
                "progress": "progress_test.json",
                "short_post": "short_test_post.json"
            }
            
            # Check which files exist
            for test_type, filename in expected_files.items():
                filepath = set_dir / filename
                
                if filepath.exists():
                    # Try to read test data
                    try:
                        with open(filepath, 'r', encoding='utf-8') as f:
                            test_data = json.load(f)
                        
                        set_info["tests"][test_type] = {
                            "file": f"set{set_num}/{filename}",
                            "title": test_data.get('metadata', {}).get('title', filename),
                            "time_limit": 60 if test_type == "progress" else 30,
                            "sequence": 1 if test_type == "short_pre" else (2 if test_type == "progress" else 3)
                        }
                    except:
                        set_info["tests"][test_type] = {
                            "file": f"set{set_num}/{filename}",
                            "title": filename.replace('.json', '').replace('_', ' ').title()
                        }
                else:
                    set_info["missing"].append(filename)
            
            # Determine status
            if not set_info["missing"]:
                set_info["status"] = "complete"
            elif "progress_test.json" in set_info["tests"]:
                set_info["status"] = "partial"
            
            metadata["test_sets"].append(set_info)
        
        return metadata if metadata["test_sets"] else None
    
    def generate_summary_report(self):
        """Generate a summary report."""
        print("\n" + "="*70)
        print("📊 ORGANIZATION SUMMARY")
        print("="*70)
        
        levels = ["elementary", "pre-intermediate", "intermediate"]
        total_units = 0
        
        for level in levels:
            level_path = self.base_dir / level
            
            if not level_path.exists():
                continue
            
            print(f"\n{level.upper()}:")
            
            # Count units
            units = [d for d in level_path.iterdir() if d.is_dir() and d.name.startswith('unit')]
            
            for unit_dir in sorted(units):
                set1_exists = (unit_dir / "set1").exists()
                set2_exists = (unit_dir / "set2").exists()
                
                set1_files = len(list((unit_dir / "set1").glob("*.json"))) if set1_exists else 0
                set2_files = len(list((unit_dir / "set2").glob("*.json"))) if set2_exists else 0
                
                status = ""
                if set1_files == 3 and set2_files == 3:
                    status = "✅ Complete (Both Sets)"
                elif set1_files == 3:
                    status = "⚠️  Set 1 Complete, Set 2 Incomplete"
                elif set1_files > 0 or set2_files > 0:
                    status = f"⚠️  Partial (Set1: {set1_files}, Set2: {set2_files})"
                else:
                    status = "❌ No tests"
                
                print(f"  {unit_dir.name}: {status}")
                total_units += 1
        
        print(f"\n{'='*70}")
        print(f"Total units processed: {total_units}")
        print("="*70)


def main():
    """Main function."""
    print("="*70)
    print("TEST SET ORGANIZER - Anti-Cheating Structure")
    print("="*70)
    print("\nThis organizer separates tests into:")
    print("  • Set 1: Progress A + Short 1A + Short 1B")
    print("  • Set 2: Progress B + Short 2A + Short 2B")
    print()
    
    organizer = TestSetOrganizer()
    
    # Create directory structure
    organizer.create_directory_structure()
    
    # Ask for source directory
    print("\n📂 Enter the path to your existing tests folder")
    print("   (e.g., 'Elementary test' or 'Tests')")
    source = input("\nSource path: ").strip()
    
    if not source:
        source = "."
    
    # Organize tests
    organizer.scan_and_organize(source)
    
    # Generate metadata
    organizer.generate_metadata()
    
    # Generate summary
    organizer.generate_summary_report()
    
    print("\n✅ Organization complete!")
    print("\nNext steps:")
    print("1. Review the organized structure in 'tests' folder")
    print("2. Add Short Test 2A and 2B files to complete Set 2")
    print("3. Use student_test_runner.py to test")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n\n⚠️  Organization cancelled")
    except Exception as e:
        print(f"\n❌ Error: {e}")
        import traceback
        traceback.print_exc()